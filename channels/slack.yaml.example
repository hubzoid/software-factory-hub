version: 1
# Slack threads start factory work as the linked person. Rename to slack.yaml and replace the placeholder
# ids with your workspace's, then:
#   hubzoid channels validate . --file channels/slack.yaml
#   hubzoid channels apply . --file channels/slack.yaml --expected-revision absent
#   hubzoid channels slack manifest . slack --output slack-app-manifest.json   # create the Slack app from it
#   hubzoid secrets set . --name SLACK_BOT_TOKEN --stdin
#   hubzoid secrets set . --name SLACK_APP_TOKEN --stdin
# Set FACTORY_SLACK_CONNECTION: slack and add slack to FACTORY_CHANNELS. See docs/channels/slack.md in the SDK.
id: slack
provider: slack
enabled: false
workflow: factory
run_as: linked_requester
allowed_groups: [engineering]
subscriptions: on_accept
progress: true
provider_config:
  transport: socket_mode            # or http when hosted, with signing_secret_ref instead of app_token_ref
  installation_team_id: T0123ABCD   # your workspace id
  app_id: A0123ABCD                 # your Slack app id
  bot_token_ref: secret:hub/software-factory/SLACK_BOT_TOKEN
  app_token_ref: secret:hub/software-factory/SLACK_APP_TOKEN
  # signing_secret_ref: secret:hub/software-factory/SLACK_SIGNING_SECRET   # http transport
  allowed_channel_ids: [C0123ABCD]  # channel ids, never names
