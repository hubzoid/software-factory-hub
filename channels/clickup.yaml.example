version: 1
# A ClickUp task moved to "ready for agent" starts factory work as the person who moved it. Questions come
# back as task comments and that person's next comment answers them; the draft pull request is linked on the
# task. Rename to clickup.yaml, replace the placeholder ids with your workspace's, then:
#   hubzoid channels apply . --file channels/clickup.yaml --expected-revision absent
#   # a person stores the ClickUp API token (pk_..., Settings, Apps), never in chat:
#   hubzoid secrets set . --ref secret:channel/software-factory/clickup/token --stdin --apply
#   hubzoid channels clickup setup . clickup          # one webhook per list (needs HUBZOID_PUBLIC_URL)
#   hubzoid channels clickup members . clickup        # ClickUp user ids
#   hubzoid channels link . clickup --external-id <clickup-user-id> --account <email>
#   hubzoid channels resume . clickup --expected-revision <rev>   # the file ships paused
# Set FACTORY_CLICKUP_CONNECTION: clickup and add clickup to FACTORY_CHANNELS. Every status named below must
# exist in each list. See docs/channels/clickup.md in the SDK.
# Who may start work here is a grant: "Start work from clickup" in Settings, Agents, Software Factory, Access.
id: clickup
provider: clickup
enabled: false
workflow: factory
run_as: linked_requester
progress: true
provider_config:
  workspace_id: "9000000001"            # the number after app.clickup.com/ in your workspace's address
  list_ids: ["901000000001"]            # the lists work may start from
  token_ref: secret:channel/software-factory/clickup/token
  trigger:
    status: ready for agent
  statuses:
    ack: in progress
    question: needs answer
    result: in review
