# Copy to .env (never commit it). Choose one installed runtime with supported authentication. Hosted/unattended use needs authentication the provider supports for it.
MODEL=claude-local
# Required: lets `hubzoid run` run the factory's durable work items.
HUBZOID_SCHEDULES=1
# Ports for the web app and the bridge.
PORT=8701
BRIDGE_PORT=8702
# The hub's public HTTPS address, needed for GitHub App webhooks on a hosted hub.
# HUBZOID_PUBLIC_URL=https://factory.example.com
